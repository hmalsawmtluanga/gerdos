#version 450
layout(local_size_x = 64) in;
layout(binding = 0) buffer D { float d[]; };
layout(binding = 1) buffer A { float a[]; };
layout(binding = 2) buffer B { float b[]; };
layout(push_constant) uniform P { uint rows; uint inner; uint columns; float dscale; float sscale; float bias; uint passes; } p;
void main() {
  uint index = gl_GlobalInvocationID.x;
  uint total = p.rows * p.columns;
  if (index >= total) { return; }
  uint i = index / p.columns;
  uint j = index % p.columns;
  for (uint pass = 0u; pass < p.passes; ++pass) {
    float acc = 0.0f;
    for (uint k = 0u; k < p.inner; ++k) { acc += a[i * p.inner + k] * b[k * p.columns + j]; }
    d[index] = d[index] * p.dscale + acc * p.sscale + p.bias;
  }
}
